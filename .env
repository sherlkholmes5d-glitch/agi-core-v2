# LM Studio Settings
LM_STUDIO_HOST=127.0.0.1
LM_STUDIO_PORT=1234
DEFAULT_MODEL=llama-3.2-3b-instruct

# Paths
LOG_LEVEL=INFO
DATA_DIR=data
CONFIG_DIR=config
PLUGINS_DIR=plugins

# RAG Settings
CHROMA_DB_PATH=data/chroma_db
SQLITE_DB_PATH=data/agi_core.db
EMBEDDING_MODEL=nomic-embed-text-v1.5

# Hardware Optimization
GPU_OFFLOAD_LAYERS=100
CONTEXT_LENGTH=32768
MAX_THREADS=12